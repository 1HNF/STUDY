# STUDY app: model settings. setup.cmd copies this file to .env; put your own key in .env, never in this file.
# Used for: making a guide from a dropped PDF, "Write more" cards/questions, filing new guides into chapters,
# and "See in guide". Studying itself works offline.

# Free key: https://console.groq.com/keys  (starts with gsk_)
SKILL_ANYTHING_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE

# Any OpenAI-compatible endpoint works. Groq (free tier, fast):
SKILL_ANYTHING_API_BASE=https://api.groq.com/openai/v1
SKILL_ANYTHING_MODEL=openai/gpt-oss-120b

# Other examples (uncomment one pair and comment the Groq pair above):
# OpenAI:      SKILL_ANYTHING_API_BASE=https://api.openai.com/v1        SKILL_ANYTHING_MODEL=gpt-4o-mini
# OpenRouter:  SKILL_ANYTHING_API_BASE=https://openrouter.ai/api/v1     SKILL_ANYTHING_MODEL=<a model id from openrouter.ai/models>

# Image generation is not used by the app; leave unset.
# HTTP proxy (optional)
# SKILL_ANYTHING_PROXY=http://127.0.0.1:7890
